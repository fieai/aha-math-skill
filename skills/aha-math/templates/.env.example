# aha-math / math-explainer —— 可选旁白配音（MiMo-V2.5-TTS）
# 用法：复制为项目根目录的 .env，填入你的 key。检测到就自动配音，没有就出无声视频。
#   cp templates/.env.example .env   然后编辑
# 注意：.env 含密钥，请勿提交到 git（skill 的 .gitignore 已忽略）。

# 必填：MiMo 平台 API Key（https://platform.xiaomimimo.com）
MIMO_API_KEY=

# 可选：音色。预置 mimo_default / 冰糖 / 茉莉 / 苏打 / 白桦 / Mia / Chloe / Milo / Dean
# 给小学生讲题推荐 茉莉 或 冰糖
MIMO_TTS_VOICE=茉莉

# 可选：API base，默认 https://api.xiaomimimo.com/v1
# MIMO_TTS_BASE=https://api.xiaomimimo.com/v1
